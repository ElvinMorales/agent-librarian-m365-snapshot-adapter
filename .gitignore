.env
.env.*
!.env.example

# Local temporary files
.tmp/

# Python environments, caches, and build outputs
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/

# Local generated exports and snapshots
exports/
private-exports/
source-snapshots/
synthetic-snapshot/
*.snapshot/
snapshots/

# Local logs and traces
*.log
*.jsonl
logs/
traces/
run-logs/

# Auth/cache material that must never be committed
.auth/
auth/
.token-cache/
.msal_cache*
*.token
*token*
*secret*
credentials*.json
*.pem
*.pfx
*.key
*.cert
